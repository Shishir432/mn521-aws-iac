# Local Terraform working directory and provider plugins
.terraform/

# State files contain resource IDs and secrets in plaintext - never commit them
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files may hold personal values (e.g. your public IP)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Generated SSH private keys
*.pem
keys/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
